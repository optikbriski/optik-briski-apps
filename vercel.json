{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "bash scripts/vercel_build.sh",
  "outputDirectory": "build/web",
  "framework": null,
  "installCommand": "echo 'Flutter install handled in build script'",
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "rekasa-karya-indonesia.vercel.app"
        }
      ],
      "destination": "/perusahaan/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/flutter_service_worker.js",
      "has": [
        {
          "type": "host",
          "value": "rekasa-karya-indonesia.vercel.app"
        }
      ],
      "destination": "/perusahaan/sw-kill.js"
    },
    {
      "source": "/perusahaan",
      "destination": "/perusahaan/index.html"
    },
    {
      "source": "/perusahaan/",
      "destination": "/perusahaan/index.html"
    },
    {
      "source": "/perusahaan/paket",
      "destination": "/perusahaan/paket.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/flutter_service_worker.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/main.dart.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
